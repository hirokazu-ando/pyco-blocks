<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="vpw">password</variable>
    <variable id="vno">nagasa_ok</variable>
    <variable id="vsa">suuji_ari</variable>
    <variable id="vmj">moji</variable>
  </variables>
  <block type="py_input" x="30" y="30">
    <field name="TYPE">str</field>
    <field name="VAR" id="vpw">password</field>
    <field name="PROMPT">パスワードを入力: </field>
    <next>
      <block type="var_set">
        <field name="VAR" id="vno">nagasa_ok</field>
        <value name="VALUE">
          <block type="cond_compare">
            <field name="OP">&gt;=</field>
            <value name="LEFT">
              <block type="py_list_len"><field name="LIST" id="vpw">password</field></block>
            </value>
            <value name="RIGHT"><block type="val_number"><field name="NUM">8</field></block></value>
          </block>
        </value>
        <next>
          <block type="var_set">
            <field name="VAR" id="vsa">suuji_ari</field>
            <value name="VALUE"><block type="val_bool"><field name="BOOL">False</field></block></value>
            <next>
              <block type="py_for_list">
                <field name="VAR" id="vmj">moji</field>
                <field name="LIST" id="vpw">password</field>
                <statement name="DO">
                  <block type="pico_if">
                    <mutation elseif="0" else="0"></mutation>
                    <value name="IF0">
                      <block type="py_str_isdigit">
                        <value name="VALUE"><block type="val_var"><field name="VAR" id="vmj">moji</field></block></value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="var_set">
                        <field name="VAR" id="vsa">suuji_ari</field>
                        <value name="VALUE"><block type="val_bool"><field name="BOOL">True</field></block></value>
                      </block>
                    </statement>
                  </block>
                </statement>
                <next>
                  <block type="pico_if">
                    <mutation elseif="0" else="1"></mutation>
                    <value name="IF0">
                      <block type="cond_and">
                        <value name="A"><block type="val_var"><field name="VAR" id="vno">nagasa_ok</field></block></value>
                        <value name="B"><block type="val_var"><field name="VAR" id="vsa">suuji_ari</field></block></value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="py_print">
                        <value name="VALUE"><block type="val_str"><field name="TEXT">数字を含む8文字以上です</field></block></value>
                      </block>
                    </statement>
                    <statement name="ELSE">
                      <block type="py_print">
                        <value name="VALUE"><block type="val_str"><field name="TEXT">条件を満たしません</field></block></value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
