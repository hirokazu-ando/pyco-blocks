<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="vd">d</variable>
  </variables>
  <block type="pico_forever" id="b1" x="30" y="30">
    <statement name="DO">
      <block type="pico_for_from_to" id="b2">
        <field name="VAR" id="vd">d</field>
        <value name="START">
          <block type="val_number" id="b3"><field name="NUM">0</field></block>
        </value>
        <value name="STOP">
          <block type="val_number" id="b4"><field name="NUM">100</field></block>
        </value>
        <value name="STEP">
          <block type="val_number" id="b5"><field name="NUM">5</field></block>
        </value>
        <statement name="DO">
          <block type="pico_pwm_write_val" id="b6">
            <field name="PIN">15</field>
            <value name="DUTY">
              <block type="val_var" id="b7"><field name="VAR" id="vd">d</field></block>
            </value>
            <next>
              <block type="pico_wait" id="b8">
                <value name="SEC">
                  <block type="val_number" id="b9"><field name="NUM">0.05</field></block>
                </value>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
