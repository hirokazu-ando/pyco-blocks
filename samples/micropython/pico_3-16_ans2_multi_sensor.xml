<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_temp">temp</variable>
    <variable id="var_humi">humi</variable>
    <variable id="var_light">light</variable>
    <variable id="var_resp">resp</variable>
  </variables>
  <block type="pico_w_wifi_connect" id="c1" x="30" y="30">
    <field name="SSID">your-ssid</field>
    <field name="PASS">your-password</field>
    <next>
      <block type="pico_forever" id="c2">
        <statement name="DO">
          <block type="pico_dht_read" id="c3">
            <field name="PIN">16</field>
            <field name="TVAR" id="var_temp">temp</field>
            <field name="HVAR" id="var_humi">humi</field>
            <next>
              <block type="pico_analog_read" id="c4">
                <field name="PIN">26</field>
                <field name="VAR" id="var_light">light</field>
                <next>
                  <block type="pico_w_http_post" id="c5">
                    <field name="URL">https://ambidata.io/api/v2/channels/YOUR_CH_ID/data</field>
                    <value name="DATA">
                      <block type="py_fstring3" id="c6">
                        <field name="PRE">{"writeKey":"YOUR_WRITE_KEY","d1":</field>
                        <value name="VAR1">
                          <block type="val_var" id="c7"><field name="VAR" id="var_temp">temp</field></block>
                        </value>
                        <field name="MID1">,"d2":</field>
                        <value name="VAR2">
                          <block type="val_var" id="c8"><field name="VAR" id="var_humi">humi</field></block>
                        </value>
                        <field name="MID2">,"d3":</field>
                        <value name="VAR3">
                          <block type="val_var" id="c9"><field name="VAR" id="var_light">light</field></block>
                        </value>
                        <field name="POST">}</field>
                      </block>
                    </value>
                    <field name="VAR" id="var_resp">resp</field>
                    <next>
                      <block type="pico_wait" id="c10">
                        <value name="SEC">
                          <block type="val_number" id="c11"><field name="NUM">30</field></block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>
