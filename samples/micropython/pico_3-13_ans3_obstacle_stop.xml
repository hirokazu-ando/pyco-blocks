<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_dist">dist</variable>
  </variables>
  <block type="pico_forever" id="d1" x="30" y="30">
    <statement name="DO">
      <block type="pico_ultrasonic_cm" id="d2">
        <field name="TRIG">14</field>
        <field name="ECHO">15</field>
        <field name="VAR" id="var_dist">dist</field>
        <next>
          <block type="pico_if" id="d3">
            <mutation elseif="0" else="1"></mutation>
            <value name="IF0">
              <block type="cond_compare" id="d4">
                <field name="OP">&lt;</field>
                <value name="LEFT">
                  <block type="val_var" id="d5"><field name="VAR" id="var_dist">dist</field></block>
                </value>
                <value name="RIGHT">
                  <block type="val_number" id="d6"><field name="NUM">20</field></block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="pico_dcmotor_stop" id="d7">
                <field name="IN1">2</field>
                <field name="IN2">3</field>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="pico_dcmotor_run" id="d8">
                <field name="IN1">2</field>
                <field name="IN2">3</field>
                <field name="EN">4</field>
                <field name="SPEED">60</field>
                <field name="DIR">fwd</field>
              </block>
            </statement>
            <next>
              <block type="pico_wait" id="d9">
                <value name="SEC">
                  <block type="val_number" id="d10"><field name="NUM">0.2</field></block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
