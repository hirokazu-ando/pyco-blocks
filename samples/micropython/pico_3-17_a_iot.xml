<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_lcd">lcd</variable>
    <variable id="var_temp">temp</variable>
    <variable id="var_humi">humi</variable>
    <variable id="var_resp">resp</variable>
  </variables>
  <block type="pico_w_wifi_connect" id="ai1" x="30" y="30">
    <field name="SSID">your-ssid</field>
    <field name="PASS">your-password</field>
    <next>
      <block type="pico_lcd_init" id="ai2">
        <field name="SDA">0</field>
        <field name="SCL">1</field>
        <field name="VAR" id="var_lcd">lcd</field>
        <next>
          <block type="pico_forever" id="ai3">
            <statement name="DO">
              <block type="pico_dht_read" id="ai4">
                <field name="PIN">16</field>
                <field name="TVAR" id="var_temp">temp</field>
                <field name="HVAR" id="var_humi">humi</field>
                <next>
                  <block type="pico_lcd_print" id="ai5">
                    <field name="VAR" id="var_lcd">lcd</field>
                    <field name="ROW">0</field>
                    <value name="TEXT">
                      <block type="py_fstring" id="ai6">
                        <field name="PRE">Temp: </field>
                        <value name="VAR">
                          <block type="val_var" id="ai7"><field name="VAR" id="var_temp">temp</field></block>
                        </value>
                        <field name="POST"> C</field>
                      </block>
                    </value>
                    <next>
                      <block type="pico_if" id="ai8">
                        <mutation elseif="0" else="1"></mutation>
                        <value name="IF0">
                          <block type="cond_compare" id="ai9">
                            <field name="OP">&gt;=</field>
                            <value name="LEFT">
                              <block type="val_var" id="ai10"><field name="VAR" id="var_temp">temp</field></block>
                            </value>
                            <value name="RIGHT">
                              <block type="val_number" id="ai11"><field name="NUM">28</field></block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="pico_servo_angle" id="ai12">
                            <field name="PIN">15</field>
                            <field name="ANGLE">90</field>
                            <next>
                              <block type="pico_lcd_print" id="ai13">
                                <field name="VAR" id="var_lcd">lcd</field>
                                <field name="ROW">1</field>
                                <value name="TEXT">
                                  <block type="val_str" id="ai14"><field name="TEXT">Fan: ON     </field></block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="pico_servo_angle" id="ai15">
                            <field name="PIN">15</field>
                            <field name="ANGLE">0</field>
                            <next>
                              <block type="pico_lcd_print" id="ai16">
                                <field name="VAR" id="var_lcd">lcd</field>
                                <field name="ROW">1</field>
                                <value name="TEXT">
                                  <block type="val_str" id="ai17"><field name="TEXT">Fan: OFF    </field></block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="pico_w_http_post" id="ai18">
                            <field name="URL">https://ambidata.io/api/v2/channels/YOUR_CH_ID/data</field>
                            <value name="DATA">
                              <block type="py_fstring" id="ai19">
                                <field name="PRE">{"writeKey":"YOUR_WRITE_KEY","d1":</field>
                                <value name="VAR">
                                  <block type="val_var" id="ai20"><field name="VAR" id="var_temp">temp</field></block>
                                </value>
                                <field name="POST">}</field>
                              </block>
                            </value>
                            <field name="VAR" id="var_resp">resp</field>
                            <next>
                              <block type="pico_wait" id="ai21">
                                <value name="SEC">
                                  <block type="val_number" id="ai22"><field name="NUM">30</field></block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
