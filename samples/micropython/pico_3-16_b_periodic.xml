<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_temp">temp</variable>
    <variable id="var_humi">humi</variable>
    <variable id="var_resp">resp</variable>
  </variables>
  <block type="pico_w_wifi_connect" id="b1" x="30" y="30">
    <field name="SSID">your-ssid</field>
    <field name="PASS">your-password</field>
    <next>
      <block type="pico_forever" id="b2">
        <statement name="DO">
          <block type="pico_dht_read" id="b3">
            <field name="PIN">16</field>
            <field name="TVAR" id="var_temp">temp</field>
            <field name="HVAR" id="var_humi">humi</field>
            <next>
              <block type="pico_w_http_post" id="b4">
                <field name="URL">https://ambidata.io/api/v2/channels/YOUR_CH_ID/data</field>
                <value name="DATA">
                  <block type="py_fstring" id="b5">
                    <field name="PRE">{"writeKey":"YOUR_WRITE_KEY","d1":</field>
                    <value name="VAR">
                      <block type="val_var" id="b6"><field name="VAR" id="var_temp">temp</field></block>
                    </value>
                    <field name="POST">}</field>
                  </block>
                </value>
                <field name="VAR" id="var_resp">resp</field>
                <next>
                  <block type="pico_wait" id="b7">
                    <value name="SEC">
                      <block type="val_number" id="b8"><field name="NUM">30</field></block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>
