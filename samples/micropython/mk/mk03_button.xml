<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <block x="30" y="30" type="pico_forever" id="b1">
    <statement name="DO">
      <block type="pico_digital_read" id="b2">
        <field name="PIN">14</field>
        <field name="VAR">btn</field>
        <field name="PULL">PULLUP_EXT</field>
        <next>
          <block type="pico_if" id="b3">
            <mutation elseif="0" else="1"></mutation>
            <value name="IF0">
              <block type="cond_compare" id="b4">
                <field name="OP">==</field>
                <value name="LEFT">
                  <block type="val_var" id="b5">
                    <field name="VAR">btn</field>
                  </block>
                </value>
                <value name="RIGHT">
                  <block type="val_number" id="b6">
                    <field name="NUM">0</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="pico_led_on" id="b7">
                <field name="PIN">15</field>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="pico_led_off" id="b8">
                <field name="PIN">15</field>
              </block>
            </statement>
            <next>
              <block type="pico_wait" id="b9">
                <value name="SEC">
                  <block type="val_number" id="b10">
                    <field name="NUM">0.05</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
