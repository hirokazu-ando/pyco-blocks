<?xml version="1.0" encoding="UTF-8"?>
<!-- Part 2 PoliviaBot #10 例a：帯の上で機体を手で動かし、位置ごとの値を読む（tools/build_pvb_samples.py が生成） -->
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="v_v">v</variable>
  </variables>
  <block type="pico_forever" x="30" y="30" id="b367">
    <statement name="DO">
      <block type="var_set" id="b361">
        <field name="VAR" id="v_v">v</field>
        <value name="VALUE">
          <block type="pvb_line_val" id="b360">
            <field name="SENSOR">27</field>
          </block>
        </value>
        <next>
          <block type="pvb_oled_label_val" id="b363">
            <field name="ROW">1</field>
            <field name="LABEL">C:</field>
            <value name="VALUE">
              <block type="val_var" id="b362">
                <field name="VAR" id="v_v">v</field>
              </block>
            </value>
            <next>
              <block type="pvb_print" id="b364">
                <field name="VAR" id="v_v">v</field>
                <next>
                  <block type="pico_wait" id="b366">
                    <value name="SEC">
                      <block type="val_number" id="b365">
                        <field name="NUM">0.2</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
