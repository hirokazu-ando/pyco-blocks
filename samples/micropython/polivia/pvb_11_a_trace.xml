<?xml version="1.0" encoding="UTF-8"?>
<!-- Part 2 PoliviaBot #11 例a：ライントレース（かんたんモード・白だけのときは直前の動きを続ける）（tools/build_pvb_samples.py が生成） -->
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="v_thr">thr</variable>
    <variable id="v_speed">speed</variable>
  </variables>
  <block type="var_set" x="30" y="30" id="b401">
    <field name="VAR" id="v_thr">thr</field>
    <value name="VALUE">
      <block type="val_number" id="b400">
        <field name="NUM">30000</field>
      </block>
    </value>
    <next>
      <block type="var_set" id="b403">
        <field name="VAR" id="v_speed">speed</field>
        <value name="VALUE">
          <block type="val_number" id="b402">
            <field name="NUM">35</field>
          </block>
        </value>
        <next>
          <block type="py_while" id="b408">
            <value name="COND">
              <block type="cond_not" id="b405">
                <value name="A">
                  <block type="pvb_switch_val" id="b404">
                    <field name="SW">13</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO">
              <block type="pico_wait" id="b407">
                <value name="SEC">
                  <block type="val_number" id="b406">
                    <field name="NUM">0.05</field>
                  </block>
                </value>
              </block>
            </statement>
            <next>
              <block type="pico_wait" id="b410">
                <value name="SEC">
                  <block type="val_number" id="b409">
                    <field name="NUM">0.5</field>
                  </block>
                </value>
                <next>
                  <block type="pico_forever" id="b434">
                    <statement name="DO">
                      <block type="pico_if" id="b416">
                        <mutation elseif="0" else="0"></mutation>
                        <value name="IF0">
                          <block type="cond_compare" id="b413">
                            <field name="OP">&gt;</field>
                            <value name="LEFT">
                              <block type="pvb_line_val" id="b411">
                                <field name="SENSOR">27</field>
                              </block>
                            </value>
                            <value name="RIGHT">
                              <block type="val_var" id="b412">
                                <field name="VAR" id="v_thr">thr</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="pvb_forward" id="b415">
                            <value name="SPEED">
                              <block type="val_var" id="b414">
                                <field name="VAR" id="v_speed">speed</field>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <next>
                          <block type="pico_if" id="b422">
                            <mutation elseif="0" else="0"></mutation>
                            <value name="IF0">
                              <block type="cond_compare" id="b419">
                                <field name="OP">&gt;</field>
                                <value name="LEFT">
                                  <block type="pvb_line_val" id="b417">
                                    <field name="SENSOR">26</field>
                                  </block>
                                </value>
                                <value name="RIGHT">
                                  <block type="val_var" id="b418">
                                    <field name="VAR" id="v_thr">thr</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="pvb_turn_left" id="b421">
                                <value name="SPEED">
                                  <block type="val_var" id="b420">
                                    <field name="VAR" id="v_speed">speed</field>
                                  </block>
                                </value>
                              </block>
                            </statement>
                            <next>
                              <block type="pico_if" id="b428">
                                <mutation elseif="0" else="0"></mutation>
                                <value name="IF0">
                                  <block type="cond_compare" id="b425">
                                    <field name="OP">&gt;</field>
                                    <value name="LEFT">
                                      <block type="pvb_line_val" id="b423">
                                        <field name="SENSOR">28</field>
                                      </block>
                                    </value>
                                    <value name="RIGHT">
                                      <block type="val_var" id="b424">
                                        <field name="VAR" id="v_thr">thr</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="pvb_turn_right" id="b427">
                                    <value name="SPEED">
                                      <block type="val_var" id="b426">
                                        <field name="VAR" id="v_speed">speed</field>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <next>
                                  <block type="pvb_if_switch" id="b431">
                                    <field name="SW">14</field>
                                    <statement name="DO">
                                      <block type="pvb_stop" id="b429">
                                        <next>
                                          <block type="py_break" id="b430">
                                          </block>
                                        </next>
                                      </block>
                                    </statement>
                                    <next>
                                      <block type="pico_wait" id="b433">
                                        <value name="SEC">
                                          <block type="val_number" id="b432">
                                            <field name="NUM">0.005</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="pvb_stop" id="b435">
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
