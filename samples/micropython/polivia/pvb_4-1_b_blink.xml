<?xml version="1.0" encoding="UTF-8"?>
<!-- Part 2 #01 ステップ2：LED1 を 0.5 秒ごとに点滅（Lチカ） -->
<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="pico_forever" id="b0" x="30" y="30">
    <statement name="DO">
      <block type="pvb_led_on" id="b1">
        <field name="LED">11</field>
        <next>
          <block type="pico_wait" id="b2">
            <value name="SEC"><block type="val_number" id="b2n"><field name="NUM">0.5</field></block></value>
            <next>
              <block type="pvb_led_off" id="b3">
                <field name="LED">11</field>
                <next>
                  <block type="pico_wait" id="b4">
                    <value name="SEC"><block type="val_number" id="b4n"><field name="NUM">0.5</field></block></value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
