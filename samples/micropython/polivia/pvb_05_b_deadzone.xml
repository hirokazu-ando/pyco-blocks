<?xml version="1.0" encoding="UTF-8"?>
<!-- Part 2 PoliviaBot #05 例b：速さを 5% ずつ上げて、動き出す境目を探す（tools/build_pvb_samples.py が生成） -->
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="v_speed">speed</variable>
  </variables>
  <block type="var_set" x="30" y="30" id="b85">
    <field name="VAR" id="v_speed">speed</field>
    <value name="VALUE">
      <block type="val_number" id="b84">
        <field name="NUM">5</field>
      </block>
    </value>
    <next>
      <block type="pico_repeat" id="b98">
        <value name="TIMES">
          <block type="val_number" id="b97">
            <field name="NUM">12</field>
          </block>
        </value>
        <statement name="DO">
          <block type="pvb_oled_label_val" id="b87">
            <field name="ROW">1</field>
            <field name="LABEL">speed:</field>
            <value name="VALUE">
              <block type="val_var" id="b86">
                <field name="VAR" id="v_speed">speed</field>
              </block>
            </value>
            <next>
              <block type="pvb_forward" id="b89">
                <value name="SPEED">
                  <block type="val_var" id="b88">
                    <field name="VAR" id="v_speed">speed</field>
                  </block>
                </value>
                <next>
                  <block type="pico_wait" id="b91">
                    <value name="SEC">
                      <block type="val_number" id="b90">
                        <field name="NUM">1.5</field>
                      </block>
                    </value>
                    <next>
                      <block type="pvb_stop" id="b92">
                        <next>
                          <block type="pico_wait" id="b94">
                            <value name="SEC">
                              <block type="val_number" id="b93">
                                <field name="NUM">1</field>
                              </block>
                            </value>
                            <next>
                              <block type="var_change" id="b96">
                                <field name="VAR" id="v_speed">speed</field>
                                <value name="AMOUNT">
                                  <block type="val_number" id="b95">
                                    <field name="NUM">5</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="pvb_oled_text" id="b100">
            <field name="ROW">2</field>
            <value name="TEXT">
              <block type="val_str" id="b99">
                <field name="TEXT">END</field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
