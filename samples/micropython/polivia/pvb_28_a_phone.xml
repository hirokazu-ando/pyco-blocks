<?xml version="1.0" encoding="UTF-8"?>
<!-- Part 2 PoliviaBot #28 例a：スマホの操縦ページで動かす（命令が来なければ前の動きを続ける）（tools/build_pvb_samples.py が生成） -->
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="v_cmd">cmd</variable>
  </variables>
  <block type="pvb_wifi_ap" x="30" y="30" id="b619">
    <field name="SSID">PoliviaBot</field>
    <field name="PASS">polivia123</field>
    <next>
      <block type="pvb_web_start" id="b620">
        <next>
          <block type="pvb_oled_clear" id="b621">
            <next>
              <block type="pvb_oled_text" id="b623">
                <field name="ROW">1</field>
                <value name="TEXT">
                  <block type="val_str" id="b622">
                    <field name="TEXT">WiFi: PoliviaBot</field>
                  </block>
                </value>
                <next>
                  <block type="pvb_oled_text" id="b625">
                    <field name="ROW">2</field>
                    <value name="TEXT">
                      <block type="val_str" id="b624">
                        <field name="TEXT">192.168.4.1</field>
                      </block>
                    </value>
                    <next>
                      <block type="pico_forever" id="b655">
                        <statement name="DO">
                          <block type="var_set" id="b627">
                            <field name="VAR" id="v_cmd">cmd</field>
                            <value name="VALUE">
                              <block type="pvb_web_button" id="b626">
                              </block>
                            </value>
                            <next>
                              <block type="pico_if" id="b652">
                                <mutation elseif="4" else="0"></mutation>
                                <value name="IF0">
                                  <block type="cond_compare" id="b630">
                                    <field name="OP">==</field>
                                    <value name="LEFT">
                                      <block type="val_var" id="b628">
                                        <field name="VAR" id="v_cmd">cmd</field>
                                      </block>
                                    </value>
                                    <value name="RIGHT">
                                      <block type="val_str" id="b629">
                                        <field name="TEXT">前進</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="IF1">
                                  <block type="cond_compare" id="b635">
                                    <field name="OP">==</field>
                                    <value name="LEFT">
                                      <block type="val_var" id="b633">
                                        <field name="VAR" id="v_cmd">cmd</field>
                                      </block>
                                    </value>
                                    <value name="RIGHT">
                                      <block type="val_str" id="b634">
                                        <field name="TEXT">後退</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="IF2">
                                  <block type="cond_compare" id="b640">
                                    <field name="OP">==</field>
                                    <value name="LEFT">
                                      <block type="val_var" id="b638">
                                        <field name="VAR" id="v_cmd">cmd</field>
                                      </block>
                                    </value>
                                    <value name="RIGHT">
                                      <block type="val_str" id="b639">
                                        <field name="TEXT">左</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="IF3">
                                  <block type="cond_compare" id="b645">
                                    <field name="OP">==</field>
                                    <value name="LEFT">
                                      <block type="val_var" id="b643">
                                        <field name="VAR" id="v_cmd">cmd</field>
                                      </block>
                                    </value>
                                    <value name="RIGHT">
                                      <block type="val_str" id="b644">
                                        <field name="TEXT">右</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="IF4">
                                  <block type="cond_compare" id="b650">
                                    <field name="OP">==</field>
                                    <value name="LEFT">
                                      <block type="val_var" id="b648">
                                        <field name="VAR" id="v_cmd">cmd</field>
                                      </block>
                                    </value>
                                    <value name="RIGHT">
                                      <block type="val_str" id="b649">
                                        <field name="TEXT">停止</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="pvb_forward" id="b632">
                                    <value name="SPEED">
                                      <block type="val_number" id="b631">
                                        <field name="NUM">50</field>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <statement name="DO1">
                                  <block type="pvb_backward" id="b637">
                                    <value name="SPEED">
                                      <block type="val_number" id="b636">
                                        <field name="NUM">50</field>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <statement name="DO2">
                                  <block type="pvb_turn_left" id="b642">
                                    <value name="SPEED">
                                      <block type="val_number" id="b641">
                                        <field name="NUM">40</field>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <statement name="DO3">
                                  <block type="pvb_turn_right" id="b647">
                                    <value name="SPEED">
                                      <block type="val_number" id="b646">
                                        <field name="NUM">40</field>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <statement name="DO4">
                                  <block type="pvb_stop" id="b651">
                                  </block>
                                </statement>
                                <next>
                                  <block type="pico_wait" id="b654">
                                    <value name="SEC">
                                      <block type="val_number" id="b653">
                                        <field name="NUM">0.02</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
