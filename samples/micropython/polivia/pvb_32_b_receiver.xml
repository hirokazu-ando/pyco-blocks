<?xml version="1.0" encoding="UTF-8"?>
<!-- Part 2 PoliviaBot #32 例b（2号機）：1号機の Wi-Fi につなぎ、「GO」が届いたら走る（tools/build_pvb_samples.py が生成） -->
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="v_msg">msg</variable>
  </variables>
  <block type="pvb_oled_clear" x="30" y="30" id="b4749">
    <next>
      <block type="pvb_oled_text" id="b4751">
        <field name="ROW">1</field>
        <value name="TEXT">
          <block type="val_str" id="b4750">
            <field name="TEXT">ROBOT 2</field>
          </block>
        </value>
        <next>
          <block type="pvb_oled_text" id="b4753">
            <field name="ROW">2</field>
            <value name="TEXT">
              <block type="val_str" id="b4752">
                <field name="TEXT">connecting...</field>
              </block>
            </value>
            <next>
              <block type="pico_w_wifi_connect" id="b4754">
                <field name="SSID">PoliviaBot</field>
                <field name="PASS">polivia123</field>
                <next>
                  <block type="pvb_oled_text" id="b4756">
                    <field name="ROW">2</field>
                    <value name="TEXT">
                      <block type="val_str" id="b4755">
                        <field name="TEXT">READY</field>
                      </block>
                    </value>
                    <next>
                      <block type="var_set" id="b4758">
                        <field name="VAR" id="v_msg">msg</field>
                        <value name="VALUE">
                          <block type="val_str" id="b4757">
                            <field name="TEXT"></field>
                          </block>
                        </value>
                        <next>
                          <block type="py_while" id="b4764">
                            <value name="COND">
                              <block type="cond_compare" id="b4761">
                                <field name="OP">!=</field>
                                <value name="LEFT">
                                  <block type="val_var" id="b4759">
                                    <field name="VAR" id="v_msg">msg</field>
                                  </block>
                                </value>
                                <value name="RIGHT">
                                  <block type="val_str" id="b4760">
                                    <field name="TEXT">GO</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO">
                              <block type="var_set" id="b4763">
                                <field name="VAR" id="v_msg">msg</field>
                                <value name="VALUE">
                                  <block type="pvb_udp_recv" id="b4762">
                                  </block>
                                </value>
                              </block>
                            </statement>
                            <next>
                              <block type="pvb_forward" id="b4766">
                                <value name="SPEED">
                                  <block type="val_number" id="b4765">
                                    <field name="NUM">40</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="pico_wait" id="b4768">
                                    <value name="SEC">
                                      <block type="val_number" id="b4767">
                                        <field name="NUM">2</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="pvb_stop" id="b4769">
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
