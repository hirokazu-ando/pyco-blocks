<?xml version="1.0" encoding="UTF-8"?>
<!-- Part 2 PoliviaBot #12 例a：前に 20cm 以内の物があれば止まる（tools/build_pvb_samples.py が生成） -->
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="v_dist">dist</variable>
  </variables>
  <block type="pico_forever" x="30" y="30" id="b450">
    <statement name="DO">
      <block type="pvb_sonar" id="b438">
        <field name="VAR" id="v_dist">dist</field>
        <next>
          <block type="pvb_oled_label_val" id="b440">
            <field name="ROW">1</field>
            <field name="LABEL">dist:</field>
            <value name="VALUE">
              <block type="val_var" id="b439">
                <field name="VAR" id="v_dist">dist</field>
              </block>
            </value>
            <next>
              <block type="pico_if" id="b449">
                <mutation elseif="0" else="1"></mutation>
                <value name="IF0">
                  <block type="cond_compare" id="b443">
                    <field name="OP">&lt;</field>
                    <value name="LEFT">
                      <block type="val_var" id="b441">
                        <field name="VAR" id="v_dist">dist</field>
                      </block>
                    </value>
                    <value name="RIGHT">
                      <block type="val_number" id="b442">
                        <field name="NUM">20</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="pvb_stop" id="b444">
                    <next>
                      <block type="pvb_led_on" id="b445">
                        <field name="LED">11</field>
                      </block>
                    </next>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="pvb_forward" id="b447">
                    <value name="SPEED">
                      <block type="val_number" id="b446">
                        <field name="NUM">40</field>
                      </block>
                    </value>
                    <next>
                      <block type="pvb_led_off" id="b448">
                        <field name="LED">11</field>
                      </block>
                    </next>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
