<?xml version="1.0" encoding="UTF-8"?>
<!-- Part 2 PoliviaBot #04 例a：1秒前進して止まる（tools/build_pvb_samples.py が生成） -->
<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="pvb_forward" x="30" y="30" id="b32">
    <value name="SPEED">
      <block type="val_number" id="b31">
        <field name="NUM">50</field>
      </block>
    </value>
    <next>
      <block type="pico_wait" id="b34">
        <value name="SEC">
          <block type="val_number" id="b33">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="pvb_stop" id="b35">
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
