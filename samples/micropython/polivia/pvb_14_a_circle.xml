<?xml version="1.0" encoding="UTF-8"?>
<!-- Part 2 PoliviaBot #14 例a：左右の速さを変えて円を描く（5秒走って止まる）（tools/build_pvb_samples.py が生成） -->
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="v_L">L</variable>
    <variable id="v_R">R</variable>
    <variable id="v_t0">t0</variable>
  </variables>
  <block type="var_set" x="30" y="30" id="b620">
    <field name="VAR" id="v_L">L</field>
    <value name="VALUE">
      <block type="val_number" id="b619">
        <field name="NUM">50</field>
      </block>
    </value>
    <next>
      <block type="var_set" id="b622">
        <field name="VAR" id="v_R">R</field>
        <value name="VALUE">
          <block type="val_number" id="b621">
            <field name="NUM">30</field>
          </block>
        </value>
        <next>
          <block type="py_while" id="b627">
            <value name="COND">
              <block type="cond_not" id="b624">
                <value name="A">
                  <block type="pvb_switch_val" id="b623">
                    <field name="SW">13</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO">
              <block type="pico_wait" id="b626">
                <value name="SEC">
                  <block type="val_number" id="b625">
                    <field name="NUM">0.05</field>
                  </block>
                </value>
              </block>
            </statement>
            <next>
              <block type="pico_wait" id="b629">
                <value name="SEC">
                  <block type="val_number" id="b628">
                    <field name="NUM">0.5</field>
                  </block>
                </value>
                <next>
                  <block type="var_set" id="b631">
                    <field name="VAR" id="v_t0">t0</field>
                    <value name="VALUE">
                      <block type="pvb_ticks_ms" id="b630">
                      </block>
                    </value>
                    <next>
                      <block type="pvb_drive" id="b634">
                        <value name="LEFT">
                          <block type="val_var" id="b632">
                            <field name="VAR" id="v_L">L</field>
                          </block>
                        </value>
                        <value name="RIGHT">
                          <block type="val_var" id="b633">
                            <field name="VAR" id="v_R">R</field>
                          </block>
                        </value>
                        <next>
                          <block type="py_while" id="b642">
                            <value name="COND">
                              <block type="cond_compare" id="b639">
                                <field name="OP">&lt;</field>
                                <value name="LEFT">
                                  <block type="py_math_op" id="b637">
                                    <field name="OP">-</field>
                                    <value name="LEFT">
                                      <block type="pvb_ticks_ms" id="b635">
                                      </block>
                                    </value>
                                    <value name="RIGHT">
                                      <block type="val_var" id="b636">
                                        <field name="VAR" id="v_t0">t0</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="RIGHT">
                                  <block type="val_number" id="b638">
                                    <field name="NUM">5000</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO">
                              <block type="pico_wait" id="b641">
                                <value name="SEC">
                                  <block type="val_number" id="b640">
                                    <field name="NUM">0.05</field>
                                  </block>
                                </value>
                              </block>
                            </statement>
                            <next>
                              <block type="pvb_stop" id="b643">
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
