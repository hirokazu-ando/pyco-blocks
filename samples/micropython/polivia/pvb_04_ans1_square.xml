<?xml version="1.0" encoding="UTF-8"?>
<!-- Part 2 PoliviaBot #04 演習の答え：四角形を走る（曲がる秒数は自分の測定値に）（tools/build_pvb_samples.py が生成） -->
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="v_turn">turn</variable>
  </variables>
  <block type="var_set" x="30" y="30" id="b58">
    <field name="VAR" id="v_turn">turn</field>
    <value name="VALUE">
      <block type="val_number" id="b57">
        <field name="NUM">0.45</field>
      </block>
    </value>
    <next>
      <block type="pico_repeat" id="b74">
        <value name="TIMES">
          <block type="val_number" id="b73">
            <field name="NUM">4</field>
          </block>
        </value>
        <statement name="DO">
          <block type="pvb_forward" id="b60">
            <value name="SPEED">
              <block type="val_number" id="b59">
                <field name="NUM">50</field>
              </block>
            </value>
            <next>
              <block type="pico_wait" id="b62">
                <value name="SEC">
                  <block type="val_number" id="b61">
                    <field name="NUM">1</field>
                  </block>
                </value>
                <next>
                  <block type="pvb_stop" id="b63">
                    <next>
                      <block type="pico_wait" id="b65">
                        <value name="SEC">
                          <block type="val_number" id="b64">
                            <field name="NUM">0.2</field>
                          </block>
                        </value>
                        <next>
                          <block type="pvb_turn_right" id="b67">
                            <value name="SPEED">
                              <block type="val_number" id="b66">
                                <field name="NUM">50</field>
                              </block>
                            </value>
                            <next>
                              <block type="pico_wait" id="b69">
                                <value name="SEC">
                                  <block type="val_var" id="b68">
                                    <field name="VAR" id="v_turn">turn</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="pvb_stop" id="b70">
                                    <next>
                                      <block type="pico_wait" id="b72">
                                        <value name="SEC">
                                          <block type="val_number" id="b71">
                                            <field name="NUM">0.2</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>
