<!-- Part 2 PoliviaBot #06 例a：SW1 を押している間だけ前進（tools/build_pvb_samples.py が生成） -->
<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="pico_forever" x="30" y="30" id="b108">
    <statement name="DO">
      <block type="pico_if" id="b105">
        <mutation elseif="0" else="1"></mutation>
        <value name="IF0">
          <block type="pvb_switch_val" id="b101">
            <field name="SW">13</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="pvb_forward" id="b103">
            <value name="SPEED">
              <block type="val_number" id="b102">
                <field name="NUM">40</field>
              </block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="pvb_stop" id="b104">
          </block>
        </statement>
        <next>
          <block type="pico_wait" id="b107">
            <value name="SEC">
              <block type="val_number" id="b106">
                <field name="NUM">0.02</field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
