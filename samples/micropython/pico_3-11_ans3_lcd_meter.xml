<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_lcd">lcd</variable>
    <variable id="var_light">light</variable>
  </variables>
  <block type="pico_lcd_init" id="li" x="30" y="30">
    <field name="SDA">0</field>
    <field name="SCL">1</field>
    <field name="VAR" id="var_lcd">lcd</field>
    <next>
      <block type="pico_forever" id="ff">
        <statement name="DO">
          <block type="pico_analog_read" id="ar1">
            <field name="PIN">26</field>
            <field name="VAR" id="var_light">light</field>
            <next>
              <block type="pico_lcd_print" id="lp1">
                <field name="VAR" id="var_lcd">lcd</field>
                <field name="ROW">0</field>
                <value name="TEXT">
                  <block type="py_fstring" id="fs1">
                    <field name="PRE">Light: </field>
                    <value name="VAR">
                      <block type="val_var" id="vv1"><field name="VAR" id="var_light">light</field></block>
                    </value>
                    <field name="POST"></field>
                  </block>
                </value>
                <next>
                  <block type="pico_lcd_print" id="lp2">
                    <field name="VAR" id="var_lcd">lcd</field>
                    <field name="ROW">1</field>
                    <value name="TEXT">
                      <block type="py_fstring" id="fs2">
                        <field name="PRE">Pct: </field>
                        <value name="VAR">
                          <block type="py_math_op" id="mp1">
                            <field name="OP">/</field>
                            <value name="LEFT">
                              <block type="py_math_op" id="mp2">
                                <field name="OP">*</field>
                                <value name="LEFT">
                                  <block type="val_var" id="vv2"><field name="VAR" id="var_light">light</field></block>
                                </value>
                                <value name="RIGHT">
                                  <block type="val_number" id="cn1"><field name="NUM">100</field></block>
                                </value>
                              </block>
                            </value>
                            <value name="RIGHT">
                              <block type="val_number" id="cn2"><field name="NUM">65535</field></block>
                            </value>
                          </block>
                        </value>
                        <field name="POST"> %</field>
                      </block>
                    </value>
                    <next>
                      <block type="pico_wait" id="w1">
                        <value name="SEC">
                          <block type="val_number" id="wn1"><field name="NUM">0.5</field></block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>
