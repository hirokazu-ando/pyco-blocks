<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="vv">val</variable>
  </variables>
  <block type="pico_forever" id="b1" x="30" y="30">
    <statement name="DO">
      <block type="pico_analog_read" id="b2">
        <field name="PIN">26</field>
        <field name="VAR" id="vv">val</field>
        <next>
          <block type="pico_pwm_write_val" id="b3">
            <field name="PIN">15</field>
            <value name="DUTY">
              <block type="py_math_op" id="b4">
                <field name="OP">/</field>
                <value name="LEFT">
                  <block type="py_math_op" id="b5">
                    <field name="OP">*</field>
                    <value name="LEFT">
                      <block type="val_var" id="b6"><field name="VAR" id="vv">val</field></block>
                    </value>
                    <value name="RIGHT">
                      <block type="val_number" id="b7"><field name="NUM">100</field></block>
                    </value>
                  </block>
                </value>
                <value name="RIGHT">
                  <block type="val_number" id="b8"><field name="NUM">65535</field></block>
                </value>
              </block>
            </value>
            <next>
              <block type="pico_wait" id="b9">
                <value name="SEC">
                  <block type="val_number" id="b10"><field name="NUM">0.02</field></block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
