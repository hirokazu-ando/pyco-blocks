<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_lcd">lcd</variable>
    <variable id="var_temp">temp</variable>
    <variable id="var_humi">humi</variable>
    <variable id="var_light">light</variable>
    <variable id="var_resp">resp</variable>
  </variables>
  <block type="pico_w_wifi_connect" id="ci1" x="30" y="30">
    <field name="SSID">your-ssid</field>
    <field name="PASS">your-password</field>
    <next>
      <block type="pico_lcd_init" id="ci2">
        <field name="SDA">0</field>
        <field name="SCL">1</field>
        <field name="VAR" id="var_lcd">lcd</field>
        <next>
          <block type="pico_forever" id="ci3">
            <statement name="DO">
              <block type="pico_dht_read" id="ci4">
                <field name="PIN">16</field>
                <field name="TVAR" id="var_temp">temp</field>
                <field name="HVAR" id="var_humi">humi</field>
                <next>
                  <block type="pico_analog_read" id="ci5">
                    <field name="PIN">26</field>
                    <field name="VAR" id="var_light">light</field>
                    <next>
                      <block type="pico_lcd_print" id="ci6">
                        <field name="VAR" id="var_lcd">lcd</field>
                        <field name="ROW">0</field>
                        <value name="TEXT">
                          <block type="py_fstring2" id="ci7">
                            <field name="PRE">T:</field>
                            <value name="VAR1">
                              <block type="val_var" id="ci8"><field name="VAR" id="var_temp">temp</field></block>
                            </value>
                            <field name="MID">C H:</field>
                            <value name="VAR2">
                              <block type="val_var" id="ci9"><field name="VAR" id="var_humi">humi</field></block>
                            </value>
                            <field name="POST">%</field>
                          </block>
                        </value>
                        <next>
                          <block type="pico_lcd_print" id="ci10">
                            <field name="VAR" id="var_lcd">lcd</field>
                            <field name="ROW">1</field>
                            <value name="TEXT">
                              <block type="py_fstring" id="ci11">
                                <field name="PRE">Light: </field>
                                <value name="VAR">
                                  <block type="val_var" id="ci12"><field name="VAR" id="var_light">light</field></block>
                                </value>
                                <field name="POST"></field>
                              </block>
                            </value>
                            <next>
                              <block type="pico_if" id="ci13">
                                <mutation elseif="0" else="0"></mutation>
                                <value name="IF0">
                                  <block type="cond_and" id="ci14">
                                    <value name="A">
                                      <block type="cond_compare" id="ci15">
                                        <field name="OP">&gt;=</field>
                                        <value name="LEFT">
                                          <block type="val_var" id="ci16"><field name="VAR" id="var_temp">temp</field></block>
                                        </value>
                                        <value name="RIGHT">
                                          <block type="val_number" id="ci17"><field name="NUM">28</field></block>
                                        </value>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="cond_compare" id="ci18">
                                        <field name="OP">&lt;</field>
                                        <value name="LEFT">
                                          <block type="val_var" id="ci19"><field name="VAR" id="var_light">light</field></block>
                                        </value>
                                        <value name="RIGHT">
                                          <block type="val_number" id="ci20"><field name="NUM">20000</field></block>
                                        </value>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="pico_buzzer_tone" id="ci21">
                                    <field name="PIN">15</field>
                                    <field name="FREQ">880</field>
                                    <field name="DUR">0.3</field>
                                  </block>
                                </statement>
                                <next>
                                  <block type="pico_w_http_post" id="ci22">
                                    <field name="URL">https://ambidata.io/api/v2/channels/YOUR_CH_ID/data</field>
                                    <value name="DATA">
                                      <block type="py_fstring3" id="ci23">
                                        <field name="PRE">{"writeKey":"YOUR_WRITE_KEY","d1":</field>
                                        <value name="VAR1">
                                          <block type="val_var" id="ci24"><field name="VAR" id="var_temp">temp</field></block>
                                        </value>
                                        <field name="MID1">,"d2":</field>
                                        <value name="VAR2">
                                          <block type="val_var" id="ci25"><field name="VAR" id="var_humi">humi</field></block>
                                        </value>
                                        <field name="MID2">,"d3":</field>
                                        <value name="VAR3">
                                          <block type="val_var" id="ci26"><field name="VAR" id="var_light">light</field></block>
                                        </value>
                                        <field name="POST">}</field>
                                      </block>
                                    </value>
                                    <field name="VAR" id="var_resp">resp</field>
                                    <next>
                                      <block type="pico_wait" id="ci27">
                                        <value name="SEC">
                                          <block type="val_number" id="ci28"><field name="NUM">30</field></block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
