<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="pico_forever" id="d1" x="30" y="30">
    <statement name="DO">
      <block type="pico_if" id="d2">
        <mutation elseif="0" else="1"></mutation>
        <value name="IF0">
          <block type="cond_compare" id="d3">
            <field name="OP">==</field>
            <value name="LEFT">
              <block type="pico_digital_read_val" id="d4">
                <field name="PIN">14</field>
                <field name="PULL">PULLUP_EXT</field>
              </block>
            </value>
            <value name="RIGHT">
              <block type="val_number" id="d5">
                <field name="NUM">0</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="pico_led_on" id="d6">
            <field name="PIN">15</field>
            <next>
              <block type="pico_wait" id="d7">
                <value name="SEC">
                  <block type="val_number" id="d8">
                    <field name="NUM">0.2</field>
                  </block>
                </value>
                <next>
                  <block type="pico_led_off" id="d9">
                    <field name="PIN">15</field>
                    <next>
                      <block type="pico_wait" id="d10">
                        <value name="SEC">
                          <block type="val_number" id="d11">
                            <field name="NUM">0.2</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="pico_led_off" id="d12">
            <field name="PIN">15</field>
          </block>
        </statement>
      </block>
    </statement>
  </block>
