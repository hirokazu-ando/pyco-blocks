<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_ip">ip</variable>
  </variables>
  <block type="pico_w_wifi_connect" id="a1" x="30" y="30">
    <field name="SSID">your-ssid</field>
    <field name="PASS">your-password</field>
    <next>
      <block type="var_set" id="a2">
        <field name="VAR" id="var_ip">ip</field>
        <value name="VALUE">
          <block type="pico_w_wifi_ip" id="a3"></block>
        </value>
        <next>
          <block type="py_print" id="a4">
            <value name="VALUE">
              <block type="py_fstring" id="a5">
                <field name="PRE">IP: </field>
                <value name="VAR">
                  <block type="val_var" id="a6"><field name="VAR" id="var_ip">ip</field></block>
                </value>
                <field name="POST"></field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
