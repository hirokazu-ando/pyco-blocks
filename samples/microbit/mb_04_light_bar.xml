<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml" mode="microbit" title="明るさを棒で表示" desc="明るいほど LED の棒が下から高くのびる（明るさ 0〜255 を 0〜5 段に分ける）">
  <variables><variable>level</variable><variable>i</variable><variable>x</variable></variables>
  <block type="mb_forever" x="30" y="30">
    <statement name="DO">
      <block type="var_set"><field name="VAR">level</field>
        <value name="VALUE">
          <block type="py_math_op"><field name="OP">//</field>
            <value name="LEFT"><block type="mb_light"></block></value>
            <value name="RIGHT"><block type="val_number"><field name="NUM">51</field></block></value>
          </block>
        </value>
        <next><block type="mb_clear">
          <next><block type="pico_for_range"><field name="VAR">i</field>
            <value name="N"><block type="val_var"><field name="VAR">level</field></block></value>
            <statement name="DO">
              <block type="pico_for_range"><field name="VAR">x</field>
                <value name="N"><block type="val_number"><field name="NUM">5</field></block></value>
                <statement name="DO">
                  <block type="mb_plot">
                    <value name="X"><block type="val_var"><field name="VAR">x</field></block></value>
                    <value name="Y">
                      <block type="py_math_op"><field name="OP">-</field>
                        <value name="LEFT"><block type="val_number"><field name="NUM">4</field></block></value>
                        <value name="RIGHT"><block type="val_var"><field name="VAR">i</field></block></value>
                      </block>
                    </value>
                  </block>
                </statement>
              </block>
            </statement>
            <next><block type="mb_pause"><value name="MS"><block type="val_number"><field name="NUM">200</field></block></value></block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
  </block>
</xml>
